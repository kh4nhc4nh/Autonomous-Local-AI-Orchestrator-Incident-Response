# ==============================================================================
# ARGUS-SOC CONFIGURATION TEMPLATE
# ==============================================================================
# Điền các thông tin IP, tài khoản, mật khẩu và Token tương ứng với hệ thống của bạn

# --- WAZUH API (Port 55000) ---
WAZUH_HOST=your_wazuh_server_ip
WAZUH_API_PORT=55000
WAZUH_USERNAME=wazuh
WAZUH_PASSWORD=your_wazuh_api_password_here
WAZUH_VERIFY_SSL=false

# --- WAZUH INDEXER / ALERTS (Port 9200) ---
INDEXER_HOST=your_wazuh_server_ip
INDEXER_PORT=9200
INDEXER_USERNAME=admin
INDEXER_PASSWORD=your_wazuh_indexer_password_here
INDEXER_VERIFY_SSL=false

# --- LOCAL AI MACHINE (Ollama) ---
OLLAMA_BASE_URL=http://your_ai_server_ip:11434
OLLAMA_MODEL=qwen2.5:3b

# --- TELEGRAM BOT NOTIFICATIONS ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
